# ==========================================
# VAEP (Verifiable Agent Escrow Protocol)
# Environment Configuration Template
# ==========================================

# ------------------------------------------
# Stellar / Soroban Network Configuration
# ------------------------------------------
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Deployed Soroban Escrow Contract ID (assigned after deployment)
SOROBAN_ESCROW_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Native or Testnet Token Contract ID (Default: Native XLM SAC or Testnet USDC)
STELLAR_ASSET_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# ------------------------------------------
# Testnet Keypairs (DO NOT COMMIT REAL SECRETS)
# Generate with: pnpm run keys:generate
# ------------------------------------------
BUYER_PUBLIC_KEY=GBUYER...
BUYER_SECRET_KEY=SBUYER...

PROVIDER_PUBLIC_KEY=GPROVIDER...
PROVIDER_SECRET_KEY=SPROVIDER...

# Multi-Verifier Quorum Keys (2-of-3)
VERIFIER_1_PUBLIC_KEY=GVERIFIER1...
VERIFIER_1_SECRET_KEY=SVERIFIER1...

VERIFIER_2_PUBLIC_KEY=GVERIFIER2...
VERIFIER_2_SECRET_KEY=SVERIFIER2...

VERIFIER_3_PUBLIC_KEY=GVERIFIER3...
VERIFIER_3_SECRET_KEY=SVERIFIER3...

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Direct PostgreSQL connection string (optional, for direct migrations)
DATABASE_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------
# Services & Gateway Configuration
# ------------------------------------------
PORT=4000
GATEWAY_URL=http://localhost:4000
MCP_SERVER_URL=http://localhost:4001
CORS_ORIGIN=http://localhost:3000

# Storage directory for local Content-Addressed Evidence Cache
EVIDENCE_STORAGE_PATH=./storage/artifacts
